# =========================================================================
# Jornada Supera - Painel Administrativo
# Copie para `.env.local`. NUNCA comite um .env com valores reais.
# =========================================================================

# --- Supabase ---
# A anon key e publica por design; a protecao real e a RLS no Postgres.
# A service_role key NUNCA entra no front-end.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Segundo fator ---
# Exigencia contratual no login do administrador. Ausente = true.
# "false" desliga o pedido do codigo no login (desenvolvimento, ou enquanto nao
# for ligado). Ligado: quem tem autenticador sempre usa o codigo, e o
# administrador sem autenticador nao opera o painel: ele abre o cadastro.
VITE_MFA_OBRIGATORIO=true

# --- Sessao ---
# Minutos de inatividade ate o logout automatico.
# 0 desliga a expiracao por completo — use apenas em desenvolvimento.
VITE_SESSION_IDLE_MINUTES=15
# Minutos antes do fim para exibir o aviso de expiracao
VITE_SESSION_WARN_MINUTES=2
